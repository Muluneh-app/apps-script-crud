<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Student Management System</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-300 min-h-screen flex items-center justify-center">


<div class="w-full max-w-3xl p-6 bg-white rounded-xl shadow-lg">
 
  <!-- LOGIN -->
  <div id="loginBox" class="space-y-4">
    <h2 class="text-2xl font-bold text-center">Login</h2>
    <input id="email" type="email" placeholder="Email" class="w-full border rounded px-3 py-2">
    <input id="password" type="password" placeholder="Password" class="w-full border rounded px-3 py-2">
    <button onclick="doLogin()" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Login</button>
    <p id="loginMsg" class="text-red-500"></p>
  </div>


  <!-- APP -->
  <div id="appBox" class="hidden space-y-6">


    <div class="flex justify-between items-center">
      <h2 class="text-xl font-bold">Dashboard</h2>
      <button onclick="doLogout()" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded">Logout</button>
    </div>


    <!-- Add Student Form -->
    <div class="space-y-2">
      <h3 class="text-lg font-semibold">Add Student</h3>
      <input id="sname" placeholder="Name" class="w-full border rounded px-3 py-2">
      <input id="semail" placeholder="Email" class="w-full border rounded px-3 py-2">
      <input id="sphone" placeholder="Phone" class="w-full border rounded px-3 py-2">
      <input id="scourse" placeholder="Course" class="w-full border rounded px-3 py-2">
      <input type="file" id="files" multiple class="w-full border rounded px-3 py-2">
      <button onclick="saveStudent()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded mt-2">Save Student</button>
    </div>


    <!-- Student Table -->
    <div class="mt-4">
      <h3 class="text-lg font-semibold">Students</h3>
      <table class="w-full mt-2 border-collapse">
        <thead>
          <tr class="bg-gray-200">
            <th class="border px-2 py-1">Name</th>
            <th class="border px-2 py-1">Email</th>
            <th class="border px-2 py-1">Phone</th>
            <th class="border px-2 py-1">Course</th>
            <th class="border px-2 py-1">Files</th>
          </tr>
        </thead>
        <tbody id="students" class="text-sm"></tbody>
      </table>
    </div>


  </div>


</div>


<script>
/******** SESSION CHECK ********/
window.onload = () => {
  google.script.run.withSuccessHandler(logged => {
    if (logged) {
      loginBox.classList.add("hidden");
      appBox.classList.remove("hidden");
      loadStudents();
    }
  }).isLoggedIn();
};


/******** LOGIN ********/
function doLogin() {
  const emailVal = email.value.trim();
  const passVal = password.value.trim();
  if (!emailVal || !passVal) { loginMsg.innerText="Email & password required"; return; }


  google.script.run.withSuccessHandler(res => {
    if (res.success) {
      loginBox.classList.add("hidden");
      appBox.classList.remove("hidden");
      loadStudents();
    } else {
      loginMsg.innerText = "Invalid login";
    }
  }).login(emailVal, passVal);
}


/******** LOGOUT ********/
function doLogout() {
  google.script.run.withSuccessHandler(() => {
    appBox.classList.add("hidden");
    loginBox.classList.remove("hidden");
  }).logout();
}


/******** LOAD STUDENTS ********/
function loadStudents() {
  google.script.run.withSuccessHandler(list => {
    students.innerHTML = "";
    list.forEach(s => {
      const fileLinks = s.files ? s.files.map(f => `<a href="${f}" target="_blank" class="text-blue-600 hover:underline">File</a>`).join(", ") : "";
      students.innerHTML += `
        <tr>
          <td class="border px-2 py-1">${s.name || ""}</td>
          <td class="border px-2 py-1">${s.email || ""}</td>
          <td class="border px-2 py-1">${s.phone || ""}</td>
          <td class="border px-2 py-1">${s.course || ""}</td>
          <td class="border px-2 py-1">${fileLinks}</td>
        </tr>
      `;
    });
  }).getStudents();
}


/******** SAVE STUDENT + FILES ********/
function saveStudent() {
  const snameVal = sname.value.trim();
  if (!snameVal) { alert("Name required"); return; }


  const filesInput = document.getElementById("files").files;
  const filesData = [];
  const readers = [];


  for (let f of filesInput) {
    readers.push(new Promise(resolve=>{
      const r = new FileReader();
      r.onload = e=>{
        filesData.push({name:f.name,type:f.type,content:e.target.result.split(",")[1]});
        resolve();
      };
      r.readAsDataURL(f);
    }));
  }


  Promise.all(readers).then(()=>{
    google.script.run.withSuccessHandler(msg=>{
      alert(msg);
      sname.value=""; semail.value=""; sphone.value=""; scourse.value=""; files.value="";
      loadStudents();
    }).addStudent({
      name: snameVal,
      email: semail.value.trim(),
      phone: sphone.value.trim(),
      course: scourse.value.trim(),
      files: filesData
    });
  });
}
</script>


</body>
</html>

