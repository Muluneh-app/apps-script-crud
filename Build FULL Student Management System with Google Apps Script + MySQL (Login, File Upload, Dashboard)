
//back-end
function getConnection() {
  const props = PropertiesService.getScriptProperties();
  return Jdbc.getConnection(
    props.getProperty("DB_URL"),
    props.getProperty("DB_USER"),
    props.getProperty("DB_PASS")
  );
}
function doGet() {
  return HtmlService.createHtmlOutputFromFile("index")
    .setTitle("Student Management System");
}
/******** SESSION ********/
function isLoggedIn() {
  return PropertiesService.getUserProperties().getProperty("user") !== null;
}


function logout() {
  PropertiesService.getUserProperties().deleteProperty("user");
  return true;
}


/******** LOGIN ********/
function login(email, password) {
  const conn = getConnection();
  const stmt = conn.prepareStatement(
    "SELECT id FROM users WHERE email=? AND password=?"
  );
  stmt.setString(1, email);
  stmt.setString(2, password);


  const rs = stmt.executeQuery();
  const ok = rs.next();


  rs.close(); stmt.close(); conn.close();


  if (ok) {
    PropertiesService.getUserProperties().setProperty("user", email);
  }
  return { success: ok };
}


/******** GET STUDENTS ********/
function getStudents() {
  const conn = getConnection();
  const stmt = conn.prepareStatement("SELECT * FROM students");
  const rs = stmt.executeQuery();
  const data = [];


  while (rs.next()) {
    const studentId = rs.getInt("id");


    // get files for this student
    const fstmt = conn.prepareStatement("SELECT fileUrl FROM student_files WHERE student_id=?");
    fstmt.setInt(1, studentId);
    const frs = fstmt.executeQuery();
    const files = [];
    while(frs.next()) files.push(frs.getString("fileUrl"));
    frs.close(); fstmt.close();


    data.push({
      id: studentId,
      name: rs.getString("name"),
      email: rs.getString("email"),
      phone: rs.getString("phone"),
      course: rs.getString("course"),
      files: files
    });
  }


  rs.close(); stmt.close(); conn.close();
  return data;
}


/******** ADD STUDENT WITH FILES ********/
function addStudent(s) {
  const conn = getConnection();


  // insert student
  const stmt = conn.prepareStatement(
    "INSERT INTO students (name,email,phone,course) VALUES (?,?,?,?)",
    Jdbc.Statement.RETURN_GENERATED_KEYS
  );
  stmt.setString(1, s.name || "");
  stmt.setString(2, s.email || "");
  stmt.setString(3, s.phone || "");
  stmt.setString(4, s.course || "");
  stmt.execute();


  const rs = stmt.getGeneratedKeys();
  rs.next();
  const studentId = rs.getInt(1);
  rs.close(); stmt.close();


  // handle files
  if (Array.isArray(s.files) && s.files.length > 0) {
    const folder = getUploadFolder(); // Drive folder
    const fstmt = conn.prepareStatement(
      "INSERT INTO student_files (student_id,fileUrl) VALUES (?,?)"
    );


    s.files.forEach(f=>{
      if (!f || !f.name || !f.content) return;


      const blob = Utilities.newBlob(
        Utilities.base64Decode(f.content),
        f.type || "application/octet-stream",
        f.name
      );
      const file = folder.createFile(blob);
      fstmt.setInt(1, studentId);
      fstmt.setString(2, file.getUrl());
      fstmt.addBatch();
    });


    fstmt.executeBatch();
    fstmt.close();
  }


  conn.close();
  return "Student added successfully!";
}


/******** DRIVE UPLOAD FOLDER ********/
function getUploadFolder() {
  const p = PropertiesService.getScriptProperties();
  let folderId = p.getProperty("UPLOAD_FOLDER_ID");


  if (!folderId) {
    const folder = DriveApp.createFolder("StudentUploads");
    p.setProperty("UPLOAD_FOLDER_ID", folder.getId());
    return folder;
  }
  return DriveApp.getFolderById(folderId);
}
