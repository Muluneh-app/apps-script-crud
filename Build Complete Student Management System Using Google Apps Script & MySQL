<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Student Management System</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-300 min-h-screen">


<!-- LOGIN PAGE -->
<div id="loginPage" class="min-h-screen flex items-center justify-center hidden">
  <div class="bg-white p-8 rounded shadow w-full max-w-md">
    <h2 class="text-2xl font-bold text-center mb-6">Admin Login</h2>
    <input id="loginEmail" type="email" placeholder="Email" class="w-full mb-3 p-3 border rounded" />
    <input id="loginPassword" type="password" placeholder="Password" class="w-full mb-4 p-3 border rounded" />
    <button onclick="login()" class="w-full bg-blue-600 text-white p-3 rounded hover:bg-blue-700">
      Login
    </button>
    <p id="loginMsg" class="text-red-500 text-center mt-3"></p>
  </div>
</div>


<!-- DASHBOARD -->
<div id="dashboard" class="hidden min-h-screen">
  <nav class="bg-blue-600 text-white p-4 flex justify-between">
    <h1 class="text-xl font-bold">Student Management System</h1>
    <button onclick="logout()" class="bg-red-500 px-4 py-2 rounded">Logout</button>
  </nav>


  <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- ADD / EDIT FORM -->
    <div class="bg-white p-6 rounded shadow">
      <h2 class="text-xl font-bold mb-4" id="formTitle">Add Student</h2>
      <input type="hidden" id="studentId" />
      <input id="name" type="text" placeholder="Full Name" class="w-full mb-3 p-3 border rounded" />
      <input id="email" type="email" placeholder="Email" class="w-full mb-3 p-3 border rounded" />
      <input id="phone" type="text" placeholder="Phone" class="w-full mb-3 p-3 border rounded" />
      <input id="course" type="text" placeholder="Course" class="w-full mb-4 p-3 border rounded" />
      <button onclick="saveStudent()" class="w-full bg-green-600 text-white p-3 rounded hover:bg-green-700">
        Save Student
      </button>
      <p id="formMsg" class="text-green-600 text-center mt-3"></p>
    </div>


    <!-- STUDENT LIST -->
    <div class="bg-white p-6 rounded shadow col-span-2">
      <h2 class="text-xl font-bold mb-4">Students List</h2>
      <table class="w-full border">
        <thead>
          <tr class="bg-gray-200">
            <th class="p-2 border">#</th>
            <th class="p-2 border">Name</th>
            <th class="p-2 border">Email</th>
            <th class="p-2 border">Phone</th>
            <th class="p-2 border">Course</th>
            <th class="p-2 border">Actions</th>
          </tr>
        </thead>
        <tbody id="studentTable"></tbody>
      </table>
    </div>
  </div>
</div>


<script>
window.onload = function() {
  // Check if user session exists
  google.script.run.withSuccessHandler(user => {
    if (user) {
      showDashboard();
    } else {
      document.getElementById("loginPage").classList.remove("hidden");
    }
  }).getCurrentUser();
}


// ===== AUTH =====
function login() {
  const email = document.getElementById("loginEmail").value.trim();
  const password = document.getElementById("loginPassword").value.trim();


  if (!email || !password) {
    document.getElementById("loginMsg").innerText = "Email and Password required!";
    return;
  }


  google.script.run.withSuccessHandler(res => {
    if (res.success) {
      showDashboard();
    } else {
      document.getElementById("loginMsg").innerText = "Invalid login!";
    }
  }).login(email, password);
}


function logout() {
  google.script.run.withSuccessHandler(() => {
    // Show login page
    document.getElementById("dashboard").classList.add("hidden");
    document.getElementById("loginPage").classList.remove("hidden");
    resetForm();
    document.getElementById("loginEmail").value = "";
    document.getElementById("loginPassword").value = "";
    document.getElementById("loginMsg").innerText = "";
    document.getElementById("studentTable").innerHTML = "";
  }).logoutUser();
}


// ===== SHOW DASHBOARD =====
function showDashboard() {
  document.getElementById("loginPage").classList.add("hidden");
  document.getElementById("dashboard").classList.remove("hidden");
  loadStudents();
}


// ===== STUDENTS CRUD =====
function saveStudent() {
  const id = document.getElementById("studentId").value;
  const data = {
    id: id ? parseInt(id) : null,
    name: document.getElementById("name").value.trim(),
    email: document.getElementById("email").value.trim(),
    phone: document.getElementById("phone").value.trim(),
    course: document.getElementById("course").value.trim()
  };


  if (!data.name || !data.email) {
    document.getElementById("formMsg").innerText = "Name and Email required!";
    return;
  }


  if (id) {
    google.script.run.withSuccessHandler(msg => {
      document.getElementById("formMsg").innerText = msg;
      resetForm();
      loadStudents();
    }).updateStudent(data);
  } else {
    google.script.run.withSuccessHandler(msg => {
      document.getElementById("formMsg").innerText = msg;
      resetForm();
      loadStudents();
    }).addStudent(data);
  }
}


function loadStudents() {
  google.script.run.withSuccessHandler(students => {
    const table = document.getElementById("studentTable");
    table.innerHTML = "";
    students.forEach((s, i) => {
      table.innerHTML += `
        <tr>
          <td class="p-2 border">${i + 1}</td>
          <td class="p-2 border">${s.name}</td>
          <td class="p-2 border">${s.email}</td>
          <td class="p-2 border">${s.phone}</td>
          <td class="p-2 border">${s.course}</td>
          <td class="p-2 border space-x-2">
            <button onclick="editStudent(${s.id})" class="bg-yellow-500 text-white px-3 py-1 rounded">Edit</button>
            <button onclick="deleteStudent(${s.id})" class="bg-red-600 text-white px-3 py-1 rounded">Delete</button>
          </td>
        </tr>`;
    });
  }).getStudents();
}


function editStudent(id) {
  google.script.run.withSuccessHandler(s => {
    if (!s) return alert("Student not found!");
    document.getElementById("studentId").value = s.id;
    document.getElementById("name").value = s.name;
    document.getElementById("email").value = s.email;
    document.getElementById("phone").value = s.phone;
    document.getElementById("course").value = s.course;
    document.getElementById("formTitle").innerText = "Edit Student";
  }).getStudentById(id);
}


function deleteStudent(id) {
  if (!confirm("Are you sure you want to delete this student?")) return;
  google.script.run.withSuccessHandler(msg => {
    alert(msg);
    loadStudents();
  }).deleteStudent(id);
}


function resetForm() {
  document.getElementById("studentId").value = "";
  document.getElementById("name").value = "";
  document.getElementById("email").value = "";
  document.getElementById("phone").value = "";
  document.getElementById("course").value = "";
  document.getElementById("formTitle").innerText = "Add Student";
  document.getElementById("formMsg").innerText = "";
}
</script>
