// ====== SESSION MANAGEMENT ======
function setCurrentUser(email, role) {
  const userProps = PropertiesService.getUserProperties();
  userProps.setProperty("currentUser", email);
  userProps.setProperty("currentRole", role);
}


function getCurrentUser() {
  const userProps = PropertiesService.getUserProperties();
  const email = userProps.getProperty("currentUser");
  const role = userProps.getProperty("currentRole");
  if (email) return { email, role };
  return null;
}


function logoutUser() {
  const userProps = PropertiesService.getUserProperties();
  userProps.deleteAllProperties();
  return true;
}


// ====== AUTH ======
function login(email, password) {
  const conn = getConnection();
  const stmt = conn.prepareStatement("SELECT * FROM users WHERE email=? AND password=?");
  stmt.setString(1, email);
  stmt.setString(2, password);
  const rs = stmt.executeQuery();


  if (rs.next()) {
    const role = rs.getString("role");
    setCurrentUser(email, role);
    rs.close();
    stmt.close();
    conn.close();
    return { success: true, role };
  }


  rs.close();
  stmt.close();
  conn.close();
  return { success: false };
}


// ====== STUDENTS CRUD ======
function addStudent(data) {
  if (!data || !data.name) return "Error: Missing student data!";
 
  const conn = getConnection();
  const stmt = conn.prepareStatement(
    "INSERT INTO students (name,email,phone,course) VALUES (?,?,?,?)"
  );
  stmt.setString(1, data.name);
  stmt.setString(2, data.email);
  stmt.setString(3, data.phone);
  stmt.setString(4, data.course);
  stmt.execute();
  stmt.close();
  conn.close();
  return "Student Added Successfully!";
}


function getStudents() {
  const conn = getConnection();
  const stmt = conn.createStatement();
  const rs = stmt.executeQuery("SELECT * FROM students ORDER BY id DESC");


  const students = [];
  while (rs.next()) {
    students.push({
      id: rs.getInt("id"),
      name: rs.getString("name"),
      email: rs.getString("email"),
      phone: rs.getString("phone"),
      course: rs.getString("course"),
      created_at: rs.getString("created_at")
    });
  }


  rs.close();
  stmt.close();
  conn.close();
  return students;
}


function getStudentById(id) {
  const conn = getConnection();
  const stmt = conn.prepareStatement("SELECT * FROM students WHERE id=?");
  stmt.setInt(1, id);
  const rs = stmt.executeQuery();


  let student = null;
  if (rs.next()) {
    student = {
      id: rs.getInt("id"),
      name: rs.getString("name"),
      email: rs.getString("email"),
      phone: rs.getString("phone"),
      course: rs.getString("course")
    };
  }


  rs.close();
  stmt.close();
  conn.close();
  return student;
}


function updateStudent(data) {
  if (!data || !data.id) return "Error: Missing student data!";
 
  const conn = getConnection();
  const stmt = conn.prepareStatement(
    "UPDATE students SET name=?, email=?, phone=?, course=? WHERE id=?"
  );
  stmt.setString(1, data.name);
  stmt.setString(2, data.email);
  stmt.setString(3, data.phone);
  stmt.setString(4, data.course);
  stmt.setInt(5, data.id);
  stmt.execute();
  stmt.close();
  conn.close();
  return "Student Updated Successfully!";
}


function deleteStudent(id) {
  const conn = getConnection();
  const stmt = conn.prepareStatement("DELETE FROM students WHERE id=?");
  stmt.setInt(1, id);
  stmt.execute();
  stmt.close();
  conn.close();
  return "Student Deleted Successfully!";
}


