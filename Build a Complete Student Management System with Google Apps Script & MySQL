<script>
window.onload = function() {
  google.script.run.withSuccessHandler(user => {
    if (user) showDashboard();
    else document.getElementById("loginPage").classList.remove("hidden");
  }).getCurrentUser();
}


// ===== AUTH =====
function login() {
  const email = document.getElementById("loginEmail").value.trim();
  const password = document.getElementById("loginPassword").value.trim();
  if (!email || !password) { document.getElementById("loginMsg").innerText = "Email and Password required!"; return; }
  google.script.run.withSuccessHandler(res => {
    if (res.success) showDashboard();
    else document.getElementById("loginMsg").innerText = "Invalid login!";
  }).login(email,password);
}
function logout() {
  google.script.run.withSuccessHandler(()=>{
    document.getElementById("dashboard").classList.add("hidden");
    document.getElementById("loginPage").classList.remove("hidden");
    resetForm();
    document.getElementById("loginEmail").value="";
    document.getElementById("loginPassword").value="";
    document.getElementById("loginMsg").innerText="";
    document.getElementById("studentTable").innerHTML="";
  }).logoutUser();
}


// ===== DASHBOARD =====
function showDashboard() {
  document.getElementById("loginPage").classList.add("hidden");
  document.getElementById("resetPage").classList.add("hidden");
  document.getElementById("registerPage").classList.add("hidden");
  document.getElementById("dashboard").classList.remove("hidden");
  loadStudents();
}


// ===== STUDENTS CRUD =====
function saveStudent() {
  const id=document.getElementById("studentId").value;
  const data={id:id?parseInt(id):null,
    name:document.getElementById("name").value.trim(),
    email:document.getElementById("email").value.trim(),
    phone:document.getElementById("phone").value.trim(),
    course:document.getElementById("course").value.trim()
  };
  if(!data.name||!data.email){document.getElementById("formMsg").innerText="Name and Email required!";return;}
  if(id){
    google.script.run.withSuccessHandler(msg=>{document.getElementById("formMsg").innerText=msg;resetForm();loadStudents();}).updateStudent(data);
  } else{
    google.script.run.withSuccessHandler(msg=>{document.getElementById("formMsg").innerText=msg;resetForm();loadStudents();}).addStudent(data);
  }
}
function loadStudents(){
  google.script.run.withSuccessHandler(students=>{
    const table=document.getElementById("studentTable");
    table.innerHTML="";
    students.forEach((s,i)=>{
      table.innerHTML+=`<tr>
        <td class="p-2 border">${i+1}</td>
        <td class="p-2 border">${s.name}</td>
        <td class="p-2 border">${s.email}</td>
        <td class="p-2 border">${s.phone}</td>
        <td class="p-2 border">${s.course}</td>
        <td class="p-2 border space-x-2">
          <button onclick="editStudent(${s.id})" class="bg-yellow-500 text-white px-3 py-1 rounded">Edit</button>
          <button onclick="deleteStudent(${s.id})" class="bg-red-600 text-white px-3 py-1 rounded">Delete</button>
        </td>
      </tr>`;
    });
  }).getStudents();
}
function editStudent(id){
  google.script.run.withSuccessHandler(s=>{
    if(!s)return alert("Student not found!");
    document.getElementById("studentId").value=s.id;
    document.getElementById("name").value=s.name;
    document.getElementById("email").value=s.email;
    document.getElementById("phone").value=s.phone;
    document.getElementById("course").value=s.course;
    document.getElementById("formTitle").innerText="Edit Student";
  }).getStudentById(id);
}
function deleteStudent(id){
  if(!confirm("Are you sure you want to delete this student?"))return;
  google.script.run.withSuccessHandler(msg=>{alert(msg);loadStudents();}).deleteStudent(id);
}
function resetForm(){
  document.getElementById("studentId").value="";
  document.getElementById("name").value="";
  document.getElementById("email").value="";
  document.getElementById("phone").value="";
  document.getElementById("course").value="";
  document.getElementById("formTitle").innerText="Add Student";
  document.getElementById("formMsg").innerText="";
}


// ===== PASSWORD RESET =====
function showResetPassword(){
  document.getElementById("loginPage").classList.add("hidden");
  document.getElementById("resetPage").classList.remove("hidden");
  document.getElementById("resetEmail").value="";
  document.getElementById("resetMsg").innerText="";
}
function backToLogin(){
  document.getElementById("resetPage").classList.add("hidden");
  document.getElementById("registerPage").classList.add("hidden");
  document.getElementById("loginPage").classList.remove("hidden");
}
function sendResetLink(){
  const email=document.getElementById("resetEmail").value.trim();
  if(!email){document.getElementById("resetMsg").innerText="Email is required!";return;}
  google.script.run.withSuccessHandler(msg=>{document.getElementById("resetMsg").innerText=msg;}).resetPassword(email);
}


// ===== REGISTER =====
function showRegister(){
  document.getElementById("loginPage").classList.add("hidden");
  document.getElementById("registerPage").classList.remove("hidden");
  document.getElementById("registerName").value="";
  document.getElementById("registerEmail").value="";
  document.getElementById("registerPassword").value="";
  document.getElementById("registerConfirmPassword").value="";
  document.getElementById("registerMsg").innerText="";
}
function registerAdmin(){
  const name=document.getElementById("registerName").value.trim();
  const email=document.getElementById("registerEmail").value.trim();
  const password=document.getElementById("registerPassword").value.trim();
  const confirm=document.getElementById("registerConfirmPassword").value.trim();
  if(!name||!email||!password||!confirm){document.getElementById("registerMsg").innerText="All fields are required!";return;}
  if(password!==confirm){document.getElementById("registerMsg").innerText="Passwords do not match!";return;}
  google.script.run.withSuccessHandler(msg=>{
    document.getElementById("registerMsg").innerText=msg;
    if(msg==="Admin registered successfully!") setTimeout(()=>backToLogin(),2000);
  }).registerUser({name,email,password});
}


// ===== CHANGE PASSWORD =====
function changePassword(){
  const current=document.getElementById("currentPassword").value.trim();
  const newPass=document.getElementById("newPassword").value.trim();
  const confirm=document.getElementById("confirmPassword").value.trim();
  if(!current||!newPass||!confirm){document.getElementById("passwordMsg").innerText="All fields are required!";return;}
  if(newPass!==confirm){document.getElementById("passwordMsg").innerText="New passwords do not match!";return;}
  google.script.run.withSuccessHandler(msg=>{
    document.getElementById("passwordMsg").innerText=msg;
    document.getElementById("currentPassword").value="";
    document.getElementById("newPassword").value="";
    document.getElementById("confirmPassword").value="";
  }).updatePassword(current,newPass);
}
</script>
</body>
</html>




function deleteStudent(id) {
  const conn = getConnection();
  const stmt = conn.prepareStatement("DELETE FROM students WHERE id=?");
  stmt.setInt(1,id);
  stmt.execute();
  stmt.close(); conn.close();
  return "Student deleted successfully!";
}

