  });
}
function getConnection() {
  const props = PropertiesService.getScriptProperties();
  return Jdbc.getConnection(
    props.getProperty("DB_URL"),
    props.getProperty("DB_USER"),
    props.getProperty("DB_PASS")
  );
}
function doGet() {
  return HtmlService.createHtmlOutputFromFile("index")
    .setTitle("Student Management System")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}


// ===== USER SESSION =====
function getCurrentUser() {
  return PropertiesService.getUserProperties().getProperty("currentUser") || null;
}


function login(email, password) {
  const conn = getConnection();
  const stmt = conn.prepareStatement("SELECT * FROM users WHERE email=? AND password=?");
  stmt.setString(1, email);
  stmt.setString(2, password);
  const rs = stmt.executeQuery();
  const success = rs.next();
  rs.close(); stmt.close(); conn.close();


  if(success) PropertiesService.getUserProperties().setProperty("currentUser", email);
  return { success };
}


function logoutUser() {
  PropertiesService.getUserProperties().deleteProperty("currentUser");
}


// ===== REGISTER ADMIN =====
function registerUser(user) {
  const conn = getConnection();
  // Check if email exists
  let stmt = conn.prepareStatement("SELECT * FROM users WHERE email=?");
  stmt.setString(1, user.email);
  let rs = stmt.executeQuery();
  if(rs.next()) { rs.close(); stmt.close(); conn.close(); return "Email already exists!"; }
  rs.close(); stmt.close();


  // Insert new admin
  stmt = conn.prepareStatement("INSERT INTO users (name,email,password) VALUES (?,?,?)");
  stmt.setString(1, user.name);
  stmt.setString(2, user.email);
  stmt.setString(3, user.password);
  stmt.execute();
  stmt.close(); conn.close();
  return "Admin registered successfully!";
}


// ===== PASSWORD RESET =====
function resetPassword(email) {
  const conn = getConnection();
  const temp = generateTempPassword();
  const stmt = conn.prepareStatement("UPDATE users SET password=? WHERE email=?");
  stmt.setString(1, temp);
  stmt.setString(2, email);
  const updated = stmt.executeUpdate();
  stmt.close(); conn.close();


  if(updated>0){
    MailApp.sendEmail(email, "Password Reset", "Your temporary password is: " + temp);
    return "Temporary password sent to your email!";
  } else {
    return "Email not found!";
  }
}


function generateTempPassword(length=8) {
  const chars="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
  let pass="";
  for(let i=0;i<length;i++) pass+=chars.charAt(Math.floor(Math.random()*chars.length));
  return pass;
}


// ===== CHANGE PASSWORD =====
function updatePassword(currentPassword, newPassword) {
  const email = getCurrentUser();
  if(!email) return "You are not logged in!";


  const conn = getConnection();
  let stmt = conn.prepareStatement("SELECT * FROM users WHERE email=? AND password=?");
  stmt.setString(1,email);
  stmt.setString(2,currentPassword);
  const rs = stmt.executeQuery();
  if(!rs.next()){ rs.close(); stmt.close(); conn.close(); return "Current password is incorrect!"; }
  rs.close(); stmt.close();


  stmt = conn.prepareStatement("UPDATE users SET password=? WHERE email=?");
  stmt.setString(1,newPassword);
  stmt.setString(2,email);
  stmt.execute();
  stmt.close(); conn.close();
  return "Password updated successfully!";
}


// ===== STUDENTS CRUD =====
function getStudents() {
  const conn = getConnection();
  const stmt = conn.prepareStatement("SELECT * FROM students ORDER BY id ASC");
  const rs = stmt.executeQuery();
  const students=[];
  while(rs.next()){
    students.push({
      id: rs.getInt("id"),
      name: rs.getString("name"),
      email: rs.getString("email"),
      phone: rs.getString("phone"),
      course: rs.getString("course")
    });
  }
  rs.close(); stmt.close(); conn.close();
  return students;
}


function addStudent(s) {
  const conn = getConnection();
  const stmt = conn.prepareStatement("INSERT INTO students (name,email,phone,course) VALUES (?,?,?,?)");
  stmt.setString(1, s.name);
  stmt.setString(2, s.email);
  stmt.setString(3, s.phone);
  stmt.setString(4, s.course);
  stmt.execute();
  stmt.close(); conn.close();
  return "Student added successfully!";
}


function getStudentById(id) {
  const conn = getConnection();
  const stmt = conn.prepareStatement("SELECT * FROM students WHERE id=?");
  stmt.setInt(1,id);
  const rs = stmt.executeQuery();
  if(rs.next()){
    const student={
      id: rs.getInt("id"),
      name: rs.getString("name"),
      email: rs.getString("email"),
      phone: rs.getString("phone"),
      course: rs.getString("course")
    };
    rs.close(); stmt.close(); conn.close();
    return student;
  } else {
    rs.close(); stmt.close(); conn.close();
    return null;
  }
}


function updateStudent(s) {
  const conn = getConnection();
  const stmt = conn.prepareStatement("UPDATE students SET name=?, email=?, phone=?, course=? WHERE id=?");
  stmt.setString(1,s.name);
  stmt.setString(2,s.email);
  stmt.setString(3,s.phone);
  stmt.setString(4,s.course);
  stmt.setInt(5,s.id);
  stmt.execute();
  stmt.close(); conn.close();
  return "Student updated successfully!";
}


<!DOCTYPE html>
<html lang="en">
