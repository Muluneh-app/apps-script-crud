  <div class="bg-white p-8 rounded shadow w-full max-w-md">
    <h2 class="text-2xl font-bold text-center mb-6">Admin Registration</h2>
    <input id="registerName" type="text" placeholder="Full Name" class="w-full mb-3 p-3 border rounded" />
    <input id="registerEmail" type="email" placeholder="Email" class="w-full mb-3 p-3 border rounded" />
    <input id="registerPassword" type="password" placeholder="Password" class="w-full mb-3 p-3 border rounded" />
    <input id="registerConfirmPassword" type="password" placeholder="Confirm Password" class="w-full mb-4 p-3 border rounded" />
