/*******************************
 * DATABASE CONNECTION
 *******************************/
function getConnection() {
  const props = PropertiesService.getScriptProperties();
  return Jdbc.getConnection(
    props.getProperty("DB_URL"),
    props.getProperty("DB_USER"),
    props.getProperty("DB_PASS")
  );
}

/*******************************
 * WEB APP ENTRY
 *******************************/
function doGet() {
  return HtmlService.createHtmlOutputFromFile("index")
    .setTitle("Payroll System")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
/*********************************
 * SAVE STUDENT
 *********************************/
function saveStudent(data) {
  try {
    validateInput(data);

    const conn = getConnection();

    // ✅ Check duplicate email
    const checkSql = "SELECT id FROM students WHERE email = ?";
    const checkStmt = conn.prepareStatement(checkSql);
    checkStmt.setString(1, data.email);
    const rs = checkStmt.executeQuery();

    if (rs.next()) {
      rs.close();
      checkStmt.close();
      conn.close();
      return "❌ Email already registered!";
    }

    rs.close();
    checkStmt.close();

    // ✅ Insert student
    const insertSql = `
      INSERT INTO students
      (first_name, gender, email, department)
      VALUES (?, ?, ?, ?)
    `;

    const stmt = conn.prepareStatement(insertSql);

    stmt.setString(1, data.firstName);
    stmt.setString(2, data.gender);
    stmt.setString(3, data.email);
    stmt.setString(4, data.department);

    stmt.execute();
    stmt.close();
    conn.close();

    return "✅ Registration successful!";

  } catch (err) {
    return "❌ " + err.message;
  }
}

/*********************************
 * VALIDATION
 *********************************/
function validateInput(data) {

  if (!data.firstName || data.firstName.trim() === "") {
    throw new Error("First Name is required");
  }

  if (!data.gender || data.gender.trim() === "") {
    throw new Error("Please select gender");
  }

  if (!data.email || data.email.trim() === "") {
    throw new Error("Email is required");
  }

  if (!isValidEmail(data.email)) {
    throw new Error("Invalid email format");
  }

  if (!data.department || data.department.trim() === "") {
    throw new Error("Please select department");
  }
}

/*********************************
 * EMAIL VALIDATOR
 *********************************/
function isValidEmail(email) {
  const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return re.test(email);
}


<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 min-h-screen flex items-center justify-center">

  <div class="bg-white w-full max-w-md p-6 rounded-2xl shadow-lg">
    
    <h2 class="text-2xl font-bold text-center text-slate-700 mb-6">
      Student Registration
    </h2>

    <div class="space-y-3">
      
      <input 
        type="text" 
        id="firstName" 
        placeholder="First Name"
        class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
        required
      >

      <select 
        id="gender"
        class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
      >
        <option value="">Select Gender</option>
        <option>Male</option>
        <option>Female</option>
      </select>

      <input 
        type="email" 
        id="email" 
        placeholder="Email"
        class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
        required
      >

      <select 
        id="department"
        class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
      >
        <option value="">Select Department</option>
        <option>Computer Science</option>
        <option>Engineering</option>
        <option>Business</option>
        <option>Medicine</option>
      </select>

      <button 
        onclick="submitForm()"
        class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition"
      >
        Register
      </button>

      <div 
        id="msg" 
        class="text-center text-green-600 font-medium mt-2"
      ></div>

    </div>
  </div>

  <script>
    function submitForm() {
      const data = {
        firstName: document.getElementById("firstName").value,
        gender: document.getElementById("gender").value,
        email: document.getElementById("email").value,
        department: document.getElementById("department").value
      };

      google.script.run
        .withSuccessHandler(function(response) {
          document.getElementById("msg").innerText = response;
          document.querySelectorAll("input").forEach(i => i.value = "");
        })
        .saveStudent(data);
    }
  </script>

</body>
</html>

